---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { getLocaleFromAstro, getTranslations, type Locale } from '../i18n';
import { getLocalizedPath, localizedPath, ROUTES } from '../utils/path';
function linkify(text: string, pageLocale: Locale): string {
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
    return `<a href="${getLocalizedPath(href, pageLocale)}">${label}</a>`;
  });
}

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const backHome = (t as { notFound?: { backHome?: string } }).notFound?.backHome ?? 'Back to home';
---

<article class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    <div class="text-left">
    <Breadcrumbs
      items={[
        { name: t.breadcrumbs?.home ?? 'Home', path: localizedPath('/', locale) },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    </div>
    <header class="mt-4 space-y-4 text-center">
      <h1 class="text-3xl font-bold normal-case md:text-4xl">{title}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
    </header>

    <Prose class="mt-10 max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p set:html={linkify(paragraph, locale)} />
          ))}
        </section>
      ))}
    </Prose>

    <div class="mt-12 flex flex-wrap justify-center gap-3 border-t border-border pt-8">
      <Button as="a" href={localizedPath(ROUTES.support, locale)} variant="primary" size="sm">
        {t.ui.contactSupport}
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={localizedPath(ROUTES.home, locale)} variant="outline" size="sm">{backHome}</Button>
    </div>
  </div>
</article>
