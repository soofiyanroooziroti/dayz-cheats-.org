---
import {
  getLocaleFromAstro,
  getTranslations,
  localeMeta,
  localePath,
  locales,
  stripLocaleFromPath,
} from '../i18n';
import type { Locale } from '../i18n/locales';
import { getBlogLocalesForSlug } from '../data/blog';
import Icon from './icons/Icon.astro';
import { localeFlagSrc } from '../utils/locale-region-codes';

interface Props {
  class?: string;
  variant?: 'header' | 'sheet';
}

const { class: className = '', variant = 'header' } = Astro.props;
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const languageUi = t.language ?? { label: 'Language', selectAria: 'Select site language' };
const basePath = stripLocaleFromPath(Astro.url.pathname);
const blogSlugMatch = basePath.match(/^\/blog\/([^/]+)\/?$/);
const blogLocalesForPage = blogSlugMatch ? getBlogLocalesForSlug(blogSlugMatch[1]!) : null;

const options = locales.map((code) => {
  let href = localePath(basePath, code);
  if (blogLocalesForPage && !blogLocalesForPage.includes(code)) {
    href = localePath('/', code);
  }
  return {
    code,
    name: localeMeta[code].nativeName,
    shortLabel: localeMeta[code].shortLabel,
    href,
    selected: code === locale,
  };
});
const shortLabel = localeMeta[locale].shortLabel;
const currentFlagSrc = localeFlagSrc(locale);
---

<div
  class:list={[
    'language-switcher relative',
    variant === 'header' ? 'language-switcher--header' : 'language-switcher--sheet w-full',
    className,
  ]}
  data-language-switcher
  data-language-variant={variant}
>
  <button
    type="button"
    class:list={[
      'language-switcher__trigger',
      variant === 'header' ? 'language-switcher__trigger--bar' : 'language-switcher__trigger--sheet w-full justify-between px-3 py-2 text-sm',
    ]}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={languageUi.selectAria}
    data-language-trigger
  >
    {variant === 'header' ? (
      <>
        <img
          src={currentFlagSrc}
          alt=""
          width="22"
          height="16"
          class="language-switcher__flag language-switcher__flag--trigger"
          loading="eager"
          decoding="async"
          fetchpriority="low"
          aria-hidden="true"
        />
        <span data-language-short>{shortLabel}</span>
        <Icon
          name="chevronDown"
          size={14}
          class="language-switcher__chevron shrink-0 opacity-75"
          aria-hidden="true"
        />
      </>
    ) : (
      <>
        <span class="flex min-w-0 flex-1 items-center gap-2 truncate">
          <img
            src={currentFlagSrc}
            alt=""
            width="22"
            height="16"
            class="language-switcher__flag language-switcher__flag--trigger shrink-0"
            loading="eager"
            decoding="async"
            fetchpriority="low"
            aria-hidden="true"
          />
          <span class="truncate" data-language-label>{localeMeta[locale].nativeName}</span>
        </span>
        <Icon name="chevronDown" size={16} class="language-switcher__chevron shrink-0 opacity-70" aria-hidden="true" />
      </>
    )}
  </button>
  <ul
    class="language-switcher__menu language-switcher__menu--panel pointer-events-none rounded-2xl border border-white/10 bg-zinc-950/95 p-2 opacity-0 shadow-2xl shadow-black/40 ring-1 ring-white/5 transition-[opacity,transform] dark:border-white/12 dark:bg-zinc-950/92"
    role="listbox"
    aria-label={languageUi.label}
    hidden
    data-language-menu
  >
    {
      options.map((opt) => (
        <li role="option" aria-selected={opt.selected}>
          <a
            href={opt.href}
            class:list={[
              'language-switcher__option flex items-center gap-3 rounded-xl px-2.5 py-2.5 text-sm transition-colors',
              opt.selected
                ? 'bg-white/8 text-foreground ring-1 ring-white/12'
                : 'text-zinc-300 hover:bg-white/6 hover:text-white',
            ]}
            hreflang={localeMeta[opt.code].hreflang}
            lang={localeMeta[opt.code].htmlLang}
            data-locale-option={opt.code}
          >
            <img
              src={localeFlagSrc(opt.code)}
              alt=""
              width="26"
              height="19"
              class="language-switcher__flag shrink-0"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
            <span
              class:list={[
                'min-w-0 flex-1 truncate text-center text-[15px]',
                opt.selected ? 'font-bold text-white' : 'font-medium text-zinc-100',
              ]}
            >
              {localeMeta[opt.code].nativeName}
            </span>
            <span
              class:list={[
                'shrink-0 text-xs font-semibold tabular-nums tracking-wide text-zinc-500',
                opt.selected && 'text-zinc-400',
              ]}
            >
              {opt.shortLabel}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  :global(.header-lang-slot),
  :global(.header-drawer-lang-slot),
  :global(.header-actions),
  :global(.site-header-pill),
  :global([data-floating-nav]) {
    overflow: visible;
  }

  .language-switcher {
    position: relative;
    flex-shrink: 0;
  }

  .language-switcher__flag {
    display: block;
    width: 1.625rem;
    height: 1.1875rem;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--foreground) 12%, transparent);
    flex-shrink: 0;
  }

  .language-switcher__flag--trigger {
    width: 1.375rem;
    height: 1rem;
  }

  /* Desktop: frosted glass; phones/tablets: skip heavy blur for smoother scroll/taps */
  @media (min-width: 68.75rem) {
    .language-switcher__menu--panel {
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }
  }

  .language-switcher__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
    background: color-mix(in oklch, var(--card) 65%, transparent);
    color: var(--foreground);
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .language-switcher__trigger--bar {
    box-sizing: border-box;
    height: 2.25rem;
    padding: 6px 10px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .language-switcher__trigger--bar:hover {
    background: color-mix(in oklch, var(--muted) 90%, var(--background));
    border-color: color-mix(in oklch, var(--primary) 28%, var(--border));
  }

  .language-switcher__chevron {
    transition: transform 0.2s ease;
  }

  .language-switcher__trigger[aria-expanded='true'] .language-switcher__chevron {
    transform: rotate(180deg);
  }

  .language-switcher--header {
    display: none;
  }

  @media (min-width: 68.75rem) {
    .language-switcher--header {
      display: block;
    }
  }

  .language-switcher__trigger--sheet {
    border-radius: 0.5rem;
    font-weight: 500;
  }

  .language-switcher--header .language-switcher__menu {
    position: fixed;
    z-index: 250;
    min-width: 15rem;
    max-height: none;
    overflow: visible;
    transform: translate3d(0, -4px, 0);
  }

  .language-switcher--sheet .language-switcher__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    z-index: 70;
    max-height: none;
    overflow: visible;
    transform: translate3d(0, -4px, 0);
  }

  .language-switcher__menu:not([hidden]) {
    pointer-events: auto;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (max-height: 720px) {
    .language-switcher__menu:not([hidden]) {
      max-height: min(70dvh, 22rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switcher__menu {
      transition: none;
      transform: none;
    }
  }
</style>
